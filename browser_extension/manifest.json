{
  "manifest_version": 3,
  "name": "EmoTrace Activity Logger",
  "version": "1.0",
  "description": "Logs active website and time spent for EmoTrace",

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}
